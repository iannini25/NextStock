# conexao com o mysql, troque a senha pela sua
DATABASE_URL=mysql+pymysql://root:sua_senha@localhost:3306/nextstock?charset=utf8mb4

# pra testar rapido sem mysql da pra usar sqlite:
# DATABASE_URL=sqlite:///nextstock.db

# chave que assina os tokens de login. troque por um texto grande e aleatorio, por exemplo o resultado de:
#   python -c "import secrets; print(secrets.token_hex(32))"
# se ficar sem, a api sobe com uma chave sorteada e todo mundo precisa entrar de novo quando ela reinicia
SECRET_KEY=troque_por_um_texto_aleatorio

# chave que criptografa a chave da API do ERP antes de salvar no banco.
# texto aleatorio de pelo menos 32 caracteres (diferente da SECRET_KEY). gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# depois de mudar o .env, reinicie a API (ela so le o .env quando sobe).
# guarde bem: se trocar essa chave, a chave do ERP salva antes precisa ser cadastrada de novo
ERP_CHAVE_CRIPTOGRAFIA=

# chave que o sensor de temperatura (ou o tools/simular_sensor.py) manda no header X-Sensor-Key
# pra registrar leituras sem login. gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# vazia = so da pra lancar leitura pela tela. depois de mudar, reinicie a API
SENSOR_API_KEY=

# chave da api do Gemini (Google AI Studio), usada so pelo assistente (RF10)
# modelo gratuito: gemini-2.5-flash
GEMINI_API_KEY=sua_chave

# clima real via Open-Meteo (nao precisa de chave). padrao: Sao Paulo
WEATHER_LAT=-23.5505
WEATHER_LON=-46.6333
WEATHER_CITY=Sao Paulo
WEATHER_TZ=America/Sao_Paulo

