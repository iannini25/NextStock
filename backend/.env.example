# conexao com o mysql, troque a senha pela sua
DATABASE_URL=mysql+pymysql://root:sua_senha@localhost:3306/nextstock?charset=utf8mb4

# pra testar rapido sem mysql da pra usar sqlite:
# DATABASE_URL=sqlite:///nextstock.db

# chave da api do Gemini (Google AI Studio), usada so pelo assistente (RF10)
# modelo gratuito: gemini-2.5-flash
GEMINI_API_KEY=sua_chave

# clima real via Open-Meteo (nao precisa de chave). padrao: Sao Paulo
WEATHER_LAT=-23.5505
WEATHER_LON=-46.6333
WEATHER_CITY=Sao Paulo
WEATHER_TZ=America/Sao_Paulo
